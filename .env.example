# Porta do servidor
PORT=3000

# ---------------------------------------------------------------- banco de dados
# Escolha UM dos dois modos.
#
# 1) Arquivo local (desenvolvimento ou servidor proprio com disco):
DATABASE_FILE=./data/agenda.sqlite
#
# 2) Turso — banco SQLite gerenciado, plano gratuito, sem cartao.
#    Quando TURSO_DATABASE_URL estiver preenchida, ela tem prioridade sobre o
#    DATABASE_FILE. Use este modo em hospedagens sem disco (ex.: Render free).
# TURSO_DATABASE_URL=libsql://sua-agenda-seu-usuario.turso.io
# TURSO_AUTH_TOKEN=cole-aqui-o-token

# ---------------------------------------------------------------- acesso
# Codigo de convite exigido no cadastro.
# Deixe em branco para permitir cadastro livre (nao recomendado).
# Compartilhe este codigo apenas com os colegas de trabalho.
INVITE_CODE=equipe-2026

# Marque como true quando o site estiver publicado em HTTPS
SECURE_COOKIES=false

# Duracao da sessao em dias
SESSION_DAYS=30
