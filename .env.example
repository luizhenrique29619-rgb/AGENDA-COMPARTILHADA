# Porta do servidor
PORT=3000

# Caminho do banco SQLite (criado automaticamente)
DATABASE_FILE=./data/agenda.sqlite

# Código de convite exigido no cadastro.
# Deixe em branco para permitir cadastro livre (não recomendado).
# Compartilhe este código apenas com os colegas de trabalho.
INVITE_CODE=equipe-2026

# Marque como true quando o site estiver publicado em HTTPS
SECURE_COOKIES=false

# Duração da sessão em dias
SESSION_DAYS=30
